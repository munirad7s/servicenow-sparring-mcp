{
  "name": "servicenow-sparring",
  "version": "0.4.0",
  "description": "Read-only MCP server that lets an AI agent check claims about ServiceNow against a live instance: out-of-the-box or custom, captured customizations, upgrade skips",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "servicenow-sparring": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/encoded-queries.md",
    "docs/examples.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "dev": "tsx src/index.ts",
    "doctor": "tsx src/index.ts doctor",
    "smoke": "tsx src/smoke.ts",
    "call": "tsx src/call.ts",
    "origin-check": "tsx src/origin-check.ts",
    "compare": "tsx src/compare.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "servicenow",
    "read-only",
    "ai-agent",
    "customization",
    "upgrade"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munirad7s/servicenow-sparring-mcp.git"
  },
  "homepage": "https://github.com/munirad7s/servicenow-sparring-mcp#readme",
  "bugs": {
    "url": "https://github.com/munirad7s/servicenow-sparring-mcp/issues"
  }
}
