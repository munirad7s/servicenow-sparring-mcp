# Settings for servicenow-sparring. Point SERVICENOW_ENV_FILE at a file like this one.
# The npm scripts (doctor, smoke, call) also read a file named .env in the folder they are run in.
# Use an account that can only read: read roles, plus the role snc_read_only.

SERVICENOW_INSTANCE_URL=https://example.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Instead of user name and password: a ready-made OAuth access token.
# SERVICENOW_TOKEN=

# Optional. Tables the server may ask for from this machine, as names or prefixes ending in *.
# An empty allow list means every table the account can read. Deny always wins.
# SERVICENOW_TABLE_ALLOW=sys_*,v_plugin,upgrade_history_task,contract_sla,sysevent_*,sysrule_assignment,dl_definition,wf_workflow_version,sc_cat_item_producer
# SERVICENOW_TABLE_DENY=sys_user,sys_user_*,sys_email

# Optional. A file that receives one line per request: tool, table, query, status, row counts.
# SERVICENOW_AUDIT_LOG=~/servicenow-sparring-audit.jsonl

# Optional request timeout in milliseconds (1000 to 120000).
# SERVICENOW_TIMEOUT_MS=30000
