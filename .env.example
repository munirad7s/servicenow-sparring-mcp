# Copy to .env, or point SERVICENOW_ENV_FILE at a file like this one.
# Use an account that can only read. ServiceNow ships the role snc_read_only for that.

SERVICENOW_INSTANCE_URL=https://example.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Instead of user name and password: a ready-made OAuth access token.
# SERVICENOW_TOKEN=

# Optional request timeout in milliseconds (1000 to 120000).
# SERVICENOW_TIMEOUT_MS=30000
